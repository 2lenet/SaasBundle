{
    "name": "2lenet/saas-bundle",
    "type": "symfony-bundle",
    "description": "SaaS helper bundle: customers, users, subscriptions and Stripe synchronisation",
    "homepage": "https://www.2le.net",
    "license": "MIT",
    "authors": [
        {
            "name": "2LE Team",
            "homepage": "https://www.2le.net/",
            "email": "support@2le.net"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Lle\\SaasBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lle\\SaasBundle\\Tests\\": "tests/phpunit/"
        }
    },
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/orm": "^3.6",
        "psr/log": "^3.0",
        "stripe/stripe-php": "^23.0",
        "symfony/config": "^8.0",
        "symfony/console": "^8.0",
        "symfony/dependency-injection": "^8.0",
        "symfony/event-dispatcher": "^8.0",
        "symfony/framework-bundle": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/routing": "^8.0",
        "symfony/security-bundle": "^8.0",
        "symfony/security-core": "^8.0",
        "symfony/security-csrf": "^8.0",
        "symfony/security-http": "^8.0",
        "symfony/validator": "^8.0",
        "symfony/yaml": "^8.0"
    },
    "require-dev": {
        "2lenet/credential-bundle": "^3.1",
        "2lenet/crudit-bundle": "^1.20",
        "monolog/monolog": "^3.5",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^13.0",
        "slevomat/coding-standard": "^8.0",
        "squizlabs/php_codesniffer": "^4.0",
        "symfony/browser-kit": "^8.0",
        "twig/twig": "^3.21"
    },
    "suggest": {
        "2lenet/credential-bundle": "Declares the ROLE_SAAS_* roles of the bundle (lle:credential:warmup)",
        "2lenet/crudit-bundle": "Admin screens of the subscriptions, plans and Stripe journals, added automatically",
        "2lenet/cruditplatform-bundle": "Declares the roles of the admin screens (ROLE_SAAS_<SCREEN>_*) to the credential bundle",
        "symfony/monolog-bundle": "Routes the Stripe logs of the bundle to their own \"saas_stripe\" channel",
        "symfony/twig-bundle": "Twig functions saas_has_subscription(), saas_has_plan(), saas_subscription()"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
