includes:
    - ../vendor/phpstan/phpstan-phpunit/extension.neon
    - ../vendor/phpstan/phpstan-symfony/extension.neon
    - ../vendor/phpstan/phpstan-symfony/rules.neon
    - ../vendor/phpstan/phpstan-doctrine/extension.neon
    - ../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    - ../vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: 8
    paths:
        - ../src
        - ../tests
    ignoreErrors:
        -
            # Symfony 8.1 deprecates HttpKernel BundleInterface but Kernel::registerBundles() still declares it
            identifier: return.deprecatedInterface
            path: phpunit/Kernel/TestKernel.php
    strictRules:
        # the team writes $this->assertXxx() in tests
        dynamicCallOnStaticMethod: false
